---
title: CatLium EduTech — Job and OCR Chunk State Lifecycles
---
%%{init: {'theme':'base','themeVariables':{'fontFamily':'serif','primaryColor':'#ffffff','primaryTextColor':'#000000','primaryBorderColor':'#000000','lineColor':'#000000','secondaryColor':'#ffffff','tertiaryColor':'#ffffff'}}}%%
stateDiagram-v2
    direction LR

    state "Async job (jobs row)" as Job {
        state "queued" as jQ
        state "processing" as jP
        state "completed" as jC
        state "failed" as jF
        state "cancelled" as jK

        [*] --> jQ
        jQ --> jP : consumer acks / coordinator adopts
        jP --> jC : worker persists + settles
        jP --> jF : terminal provider/parse error
        jP --> jK : API cancel or sweep settle
        jQ --> jF : publish failed (never silent orphan)
        jQ --> jK : API cancel
        jF --> jQ : retry (jobs/:id/retry)
        jC --> [*]
        jK --> [*]
    }

    state "OCR chunk (ocr_chunks row)" as CK {
        state "pending" as cP
        state "claimed" as cL
        state "submitted" as cS
        state "failed" as cF
        state "cancelled" as cK

        [*] --> cP : coordinator materializes page range
        cP --> cL : claim (lease 300 s, FOR UPDATE SKIP LOCKED, attempts+1)
        cL --> cS : result valid, pages match range
        cL --> cP : lease expired / worker disabled, sweep reclaims
        cP --> cF : permanent error
        cS --> [*]
        cF --> cP : retryable, attempts < MAX=3, sweep re-queues
        cF --> [*] : attempts reach MAX=3, terminal
        cP --> cK : job cancelled
        cL --> cK : job cancelled
        cK --> [*]
    }

    Job --> CK : one material job owns its chunk set (coordinator materializes ranges)