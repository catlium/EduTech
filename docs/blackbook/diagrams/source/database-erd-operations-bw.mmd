    question_types {
        uuid id PK
        uuid institute_id FK "NULL = global starter"
        varchar code UK "per track"
        varchar answer_format "MCQ | TRUE_FALSE | FILL_IN_BLANK | TEXT | MATCHING | NUMERICAL"
        varchar kind "OBJECTIVE | SUBJECTIVE"
        int default_marks
        jsonb evaluation_config
    }
    questions {
        uuid id PK
        uuid institute_id FK
        text stem
        varchar question_type
        varchar answer_format
        varchar difficulty "EASY | MEDIUM | HARD"
        text explanation
        jsonb payload
        varchar approval_status "PENDING | APPROVED | REJECTED"
        uuid source_pattern_id FK
    }
    paper_patterns {
        uuid id PK
        uuid institute_id FK
        varchar title
        varchar status "DRAFT | REVIEW | APPROVED"
        boolean is_locked
        int version
        varchar source_type "MANUAL | TEXT | MATERIAL | PREVIOUS_YEAR_PAPER"
        jsonb structure
    }
    paper_pattern_subjects {
        uuid pattern_id FK
        uuid subject_id FK
    }
    question_papers {
        uuid id PK
        uuid institute_id FK
        uuid blueprint_id FK "set-null"
        varchar title
        jsonb instructions
        int max_marks
    }
    question_paper_questions {
        uuid id PK
        uuid paper_id FK
        uuid question_id FK "live FK, KNOWN GAP"
        int marks
        varchar section
    }
    assessments {
        uuid id PK
        uuid institute_id FK
        varchar title
        int duration_minutes
        int max_marks
        varchar status "DRAFT | PUBLISHED | ACTIVE | COMPLETED"
        uuid blueprint_id FK "set-null"
        timestamp starts_at
        timestamp ends_at
    }
    assessment_questions {
        uuid assessment_id FK
        uuid question_id FK
        int sort_order
        int marks
        varchar section
    }
    attempts {
        uuid id PK
        uuid institute_id FK
        uuid assessment_id FK
        uuid student_id FK
        varchar status "IN_PROGRESS | SUBMITTED | EXPIRED"
        timestamp deadline
        int score
        int total_marks
        timestamp submitted_at
    }
    attempt_questions {
        uuid id PK
        uuid attempt_id FK
        uuid question_id FK "snapshot at start"
        int marks
        text stem
        jsonb payload
    }
    attempt_responses {
        uuid attempt_question_id PK,FK
        jsonb answer
        boolean is_correct
        int marks_awarded
    }
    practice_sessions {
        uuid id PK
        uuid institute_id FK
        uuid student_id FK
        varchar mode "FLASHCARD | QUESTION"
        varchar status "IN_PROGRESS | COMPLETED"
        uuid content_id FK "flashcards"
        uuid topic_id FK "question mode"
    }
    practice_session_items {
        uuid id PK
        uuid session_id FK
        varchar source_key "fc:ID | q:ID"
        varchar prompt
        varchar reveal
        jsonb payload
    }
    practice_session_responses {
        uuid session_item_id PK,FK
        jsonb answer
        varchar rating "AGAIN | GOOD"
        boolean is_correct
    }
    syllabi {
        uuid id PK
        uuid institute_id FK
        uuid subject_id FK
        int version
        varchar processing_status "UPLOADED | QUEUED | PROCESSING | READY | FAILED"
        varchar analysis_status "PENDING | PROCESSING | READY | FAILED"
        varchar status "PROPOSED | CONFIRMED | ARCHIVED"
        jsonb context
        jsonb structure
    }
    jobs {
        uuid id PK
        uuid institute_id FK
        varchar type
        varchar status "queued | processing | completed | failed | cancelled"
        jsonb payload
        uuid created_by FK "NULL = system"
        timestamp completed_at
    }
    workers {
        uuid id PK
        varchar name
        varchar token_hash UK "SHA-256 of owr_ key"
        boolean enabled
        timestamp last_heartbeat_at
        jsonb capabilities
    }
    ocr_chunks {
        uuid id PK
        uuid job_id FK
        uuid institute_id FK
        int chunk_index
        int start_page
        int end_page
        varchar status "pending | claimed | submitted | failed | cancelled"
        uuid claimed_by FK
        timestamp lease_expires_at
        int attempts
    }