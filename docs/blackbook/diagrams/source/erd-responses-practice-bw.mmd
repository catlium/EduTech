%%{init: {'theme':'base','themeVariables':{'fontFamily':'serif','primaryColor':'#ffffff','primaryTextColor':'#000000','primaryBorderColor':'#000000','lineColor':'#000000','secondaryColor':'#ffffff','tertiaryColor':'#ffffff'},'htmlLabels':false,'er':{'useMaxWidth':false}}}%%
erDiagram
    attempts ||--o{ attempt_questions : attempt_id
    attempts ||--o{ practice_sessions : student_id "shared through student"
    institutes ||--o{ practice_sessions : institute_id
    practice_sessions ||--o{ practice_session_items : session_id
    practice_session_items ||--o{ practice_session_responses : session_item_id

    attempts {
        uuid id PK
        uuid assessment_id FK "refs assessments figure"
        varchar status "IN_PROGRESS | SUBMITTED | EXPIRED"
        int score
    }
    attempt_questions {
        uuid id PK
        uuid attempt_id FK
        uuid question_id FK "snapshot at start"
        int marks
        text stem
        jsonb payload
    }
    attempt_responses {
        uuid attempt_question_id PK,FK
        jsonb answer
        boolean is_correct
        int marks_awarded
    }
    institutes {
        uuid id PK
        varchar name
    }
    practice_sessions {
        uuid id PK
        uuid institute_id FK
        uuid student_id FK
        varchar mode "FLASHCARD | QUESTION"
        varchar status "IN_PROGRESS | COMPLETED"
    }
    practice_session_items {
        uuid id PK
        uuid session_id FK
        varchar source_key "fc:ID | q:ID"
        varchar prompt
        varchar reveal
    }
    practice_session_responses {
        uuid session_item_id PK,FK
        jsonb answer
        varchar rating "AGAIN | GOOD"
        boolean is_correct
    }