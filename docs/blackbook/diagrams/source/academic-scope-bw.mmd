flowchart LR
    M["resolveScope(membershipId)<br/>DB-fresh, never from JWT"]

    M --> A{"Membership holds<br/>INSTITUTE_ADMIN?"}
    A -->|yes| WI["whole-institute<br/>scope (sole bypass; platform still locked)"]
    A -->|no| SU["subject-set =<br/>teacher scope ∪ student scope"]
    SU --> TMS["Teacher: subject of each active<br/>teacher_assignment → class_subjects"]
    SU --> STS["Student: placement division → class<br/>class_subjects − EXCLUDED ∪ ENROLLED"]
    WI --> ENF["Enforcement on resources<br/>with subject chain"]
    SU --> ENF
    STS --> ENF
    TMS --> ENF

    ENF --> R{"Operation type"}
    R -->|read/list| R1["WHERE subject_id IN scope<br/>in the SQL itself"]
    R -->|single read| R2["Out of scope → 404<br/>(no existence leak)"]
    R -->|write on resource| R3["Pre-mutation check → 403"]
    R -->|create| R4["Created within actor scope<br/>only; admin bypass OK"]
    R1 --> RI["Authorized rows returned"]
    R2 --> RD["404 Not Found"]
    R3 --> RW["403 Forbidden"]
    R4 --> RC["Resource created in scope"]

