%%{init: {'theme':'base','themeVariables':{'fontFamily':'serif','primaryColor':'#ffffff','primaryTextColor':'#000000','primaryBorderColor':'#000000','lineColor':'#000000','secondaryColor':'#ffffff','tertiaryColor':'#ffffff'},'htmlLabels':false,'er':{'useMaxWidth':false}}}%%
erDiagram
    institutes ||--o{ paper_patterns : institute_id
    materials ||--o{ paper_patterns : source_material_id
    paper_patterns ||--o{ paper_pattern_subjects : pattern_id
    subjects ||--o{ paper_pattern_subjects : subject_id

    institutes {
        uuid id PK
        varchar name
        varchar slug UK
    }
    materials {
        uuid id PK
        uuid institute_id FK
        varchar material_type "PDF | IMAGE | DOCUMENT | TEXT"
    }
    paper_patterns {
        uuid id PK
        uuid institute_id FK
        uuid source_material_id FK "previous year paper"
        varchar title
        varchar status "DRAFT | REVIEW | APPROVED"
        boolean is_locked
        int version
        varchar source_type "MANUAL | TEXT | MATERIAL | PREVIOUS_YEAR_PAPER"
        jsonb structure
    }
    paper_pattern_subjects {
        uuid pattern_id FK
        uuid subject_id FK
    }
    subjects {
        uuid id PK
        uuid institute_id FK
        varchar name
        varchar slug UK "per institute"
    }