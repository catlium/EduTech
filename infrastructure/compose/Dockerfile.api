# ─────────────────────────────────────────────────────────────
# CatLium EduTech — API image (NestJS modular monolith) / web (Next.js)
#
# One image serves BOTH the NestJS API and the Next.js web app (each picks
# its runtime command via the compose service definition). The web bundle
# inlines NEXT_PUBLIC_API_URL (the browser-visible API URL) at build time —
# pass it as a build ARG when the machine serving the browser is not
# `localhost`.
#
# The API imports the `@catlium/*` workspace packages, which are
# TypeScript ESM packages that resolve to their built `dist/`. So the
# image builds the whole pnpm workspace (turbo build → all package
# dists) and copies that into a runtime stage.
#
# Services using this image:
#   - `api`    → node apps/api/dist/main.js            (default CMD)
#   - `web`    → pnpm --filter @catlium/web exec next start -p 3001
#   - `migrate`→ drizzle-kit migrate (one-shot)
#   - `seed`   → tsx ./scripts/seed-demo.ts (demo override, one-shot)
# ─────────────────────────────────────────────────────────────

# ── Build stage: install + compile the full workspace ──
# Node 24 (LTS): the repo pins pnpm 11.1.2 (needs Node >=22.13) and
# `node:sqlite` (Node >=22.5).
FROM node:24-alpine AS build
WORKDIR /app

# Browser-visible API URL, baked into the web bundle during `next build`.
# Must be passed through the compose `build.args` for non-localhost hosts.
ARG NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

ENV NEXT_TELEMETRY_DISABLED=1

# Pin pnpm to the repo's packageManager version.
RUN corepack enable

# Copy the whole repo (respecting .dockerignore), then install and build.
COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm build

# ── Runtime stage ──
# ponytail: ships the full workspace (dev deps included) to avoid fragile
# dependency-pruning; fine for dev, revisit when image size matters.
FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app /app

# The API start script is `node dist/main` (relative to apps/api).
CMD ["node", "apps/api/dist/main.js"]
