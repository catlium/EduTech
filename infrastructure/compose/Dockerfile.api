# ─────────────────────────────────────────────────────────────
# CatLium EduTech — API image (NestJS modular monolith) / web (Next.js)
#
# One image serves BOTH the NestJS API and the Next.js web app (each picks
# its runtime command via the compose service definition). The web bundle
# inlines NEXT_PUBLIC_API_URL (the browser-visible API URL) at build time —
# pass it as a build ARG when the machine serving the browser is not
# `localhost`.
#
# The API imports the `@catlium/*` workspace packages, which are
# TypeScript ESM packages that resolve to their built `dist/`. So the
# image builds the whole pnpm workspace (turbo build → all package
# dists) and copies that into a runtime stage.
#
# BUILD ORDER (monorepo cache-friendly):
#   1. manifests + lockfile only → `pnpm install` (cached; invalidates only
#      when a package.json / pnpm-lock.yaml / pnpm-workspace.yaml changes).
#      The pnpm store lives on a BuildKit cache mount, so even a lock bump
#      re-uses previously fetched tarballs instead of re-downloading.
#   2. COPY the full source → `pnpm build`. Turbo's local cache lives on a
#      cache mount too (TURBO_CACHE_DIR), so unchanged workspaces are
#      restored from cache instead of recompiled.
#   3. Runtime stage keeps the chromium PDF renderer.
#
# Services using this image:
#   - `api`    → node apps/api/dist/main.js            (default CMD)
#   - `web`    → pnpm --filter @catlium/web exec next start -p 3001
#   - `migrate`→ drizzle-kit migrate (one-shot)
#   - `seed`   → tsx ./scripts/seed-demo.ts (demo override, one-shot)
# ─────────────────────────────────────────────────────────────

FROM node:24-alpine AS build
WORKDIR /app

# Browser-visible API URL, baked into the web bundle during `next build`.
# Must be passed through the compose `build.args` for non-localhost hosts.
ARG NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_TELEMETRY_DISABLED=1 \
    PNPM_HOME=/pnpm

# Pin pnpm to the repo's packageManager version; keep its store on a cache
# mount so dependency installs survive rebuilds.
RUN corepack enable
ENV npm_config_store_dir=/pnpm-store

# ── 1. Dependencies: manifests + lockfile FIRST so the install layer only
#       rebuilds when they change. `allowBuilds`/workspace globs come from
#       pnpm-workspace.yaml; each workspace member's package.json is copied
#       so pnpm can resolve the whole graph. Add a line here when a new
#       workspace member is added.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/ai/package.json packages/ai/package.json
COPY packages/auth/package.json packages/auth/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN --mount=type=cache,target=/pnpm-store pnpm install --frozen-lockfile

# ── 2. Source + compile (unchanged workspaces come back from the turbo
#       cache instead of recompiling).
COPY . .
# Turborepo respects TURBO_CACHE_DIR for its local cache; persist it so
# `pnpm build` only recompiles packages that actually changed.
ENV TURBO_CACHE_DIR=/turbo-cache
RUN --mount=type=cache,target=/turbo-cache pnpm build

# ── Runtime stage ──
# ponytail: ships the full workspace (dev deps included) to avoid fragile
# dependency-pruning; fine for dev+single-image prod, revisit when image
# size matters.
FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

# PDF export renders via puppeteer-core + a system Chromium (alpine's apk
# package). Without it every PDF export 500s; PUPPETEER_EXECUTABLE_PATH is
# left as a knob for operators who supply their own browser.
RUN apk add --no-cache chromium ttf-freefont font-noto-cjk font-noto-extra
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

COPY --from=build /app /app

# The API start script is `node dist/main` (relative to apps/api).
CMD ["node", "apps/api/dist/main.js"]