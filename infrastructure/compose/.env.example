# ─────────────────────────────────────────────────────────────
# CatLium EduTech - Docker Compose environment example
# ─────────────────────────────────────────────────────────────
#
# Copy this to the repo-root `.env` BEFORE running compose:
#
#     cp infrastructure/compose/.env.example .env
#
# The root `.env` is loaded into every app container (env_file in
# docker-compose.yml). Connection URLs that must point at container
# hostnames (postgres/rabbitmq/redis/ocr/omniroute) are already overridden
# inside the compose file, so the values below are just the safe dev
# defaults — tune the ones you need.
#
# Auth/secrets in production: override these (never commit real secrets).

# ── Infra credentials (must match what postgres/rabbitmq use) ──
POSTGRES_USER=catlium
POSTGRES_PASSWORD=catlium_dev_secret
POSTGRES_DB=catlium_dev
RABBITMQ_USER=catlium
RABBITMQ_PASSWORD=catlium_dev_secret

# ── API ──
API_PORT=3000
CORS_ORIGIN=http://localhost:3001

# JWT — generate a strong secret in production: openssl rand -hex 64
JWT_SECRET=change-me-to-a-secure-random-string
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30

# Cookies
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Rate limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_LIMIT=5

# (DATABASE_URL / REDIS_URL / RABBITMQ_URL for the API are overridden in
# compose to point at the container hostnames — no need to set them here.)

# ── Internal services auth ──
# Shared secret for the `x-internal-api-key` convention (workers -> OCR).
# Empty in local dev; MUST be set in production. openssl rand -hex 32
INTERNAL_API_KEY=

# ── OCR ──
OCR_PORT=8000

# ── OmniRoute (internal AI gateway) ──
# The compose dev override supplies loopback-only dev defaults; production
# MUST set real values here (never use the dev fallbacks).
OMNIROUTE_INITIAL_PASSWORD=
OMNIROUTE_JWT_SECRET=

# ── Workers ──
# WORKER_ROLE is set per-service (material | ai) in the compose file;
# you do NOT need to set it here.
# WORKER_AI_PROVIDER_URL defaults to the internal OmniRoute gateway
# (http://omniroute:20128/v1) inside the compose file. No local LLM.
WORKER_AI_API_KEY=
WORKER_AI_MODEL=auto
WORKER_AI_TIMEOUT_SECONDS=60
WORKER_AI_QUEUE=ai_generation
WORKER_AI_MAX_CONTEXT_CHARS=40000
WORKER_AI_CHUNK_SIZE_CHARS=12000
WORKER_AI_CHUNK_OVERLAP_CHARS=400