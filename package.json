{
  "name": "catlium-edutech",
  "private": true,
  "description": "CatLium EduTech - Multi-tenant EdTech SaaS Platform",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@catlium/api",
    "dev:ocr": "turbo run dev --filter=@catlium/ocr",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @catlium/database run generate",
    "db:migrate": "pnpm --filter @catlium/database run migrate",
    "db:seed": "pnpm --filter @catlium/database run seed",
    "db:studio": "pnpm --filter @catlium/database run studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.5.3",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  }
}
