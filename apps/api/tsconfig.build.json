{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@catlium/contracts": ["../../packages/contracts/src"],
      "@catlium/database": ["../../packages/database/src"],
      "@catlium/auth": ["../../packages/auth/src"],
      "@catlium/shared": ["../../packages/shared/src"]
    }
  },
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
