{
  "name": "@catlium/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "CatLium EduTech - Main API (Modular Monolith)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:analytics": "node --test src/attempts/analytics.test.ts",
    "test:paper-patterns": "node --test src/paper-patterns/paper-patterns.validation.test.ts",
    "test:paper-pattern-subjects": "node --test src/paper-patterns/paper-pattern-subjects.test.ts",
    "test:paper-pattern-policy": "node --test src/paper-patterns/paper-pattern-policy.test.ts",
    "test:export": "node --test src/export/export.service.test.ts",
    "test:pdf-smoke": "node --test src/export/pdf-smoke.test.ts",
    "test:ocr": "node --test src/ocr/ocr-workers.test.ts src/ocr/ocr-coordinator.util.test.ts src/ocr/ocr-page-inspection.test.ts",
    "test:ocr-worker": "tsx --test src/ocr/ocr-worker-flow.integration.ts",
    "test:paper-pattern-export": "node --test src/export/paper-pattern-doc.test.ts",
    "test:teacher-assignments": "tsx --test src/academic-structure/teacher-assignments.integration.ts",
    "test:student-placements": "tsx --test src/academic-structure/student-placements.integration.ts",
    "test:academic-scope": "tsx --test src/authorization/academic-scope.integration.ts",
    "test:auth-session": "tsx --test src/identity/auth-session.integration.ts",
    "test:resource-scope": "tsx --test src/authorization/resource-scope.integration.ts",
    "test:authz-regression": "tsx --test src/authorization/authz-regression.integration.ts",
    "test:phase-m-remediation": "tsx --test src/authorization/phase-m-remediation.integration.ts",
    "test:job-ownership": "tsx --test src/authorization/job-ownership.integration.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@catlium/contracts": "workspace:*",
    "@catlium/database": "workspace:*",
    "@catlium/shared": "workspace:*",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/throttler": "^6.5.0",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.44.7",
    "jszip": "^3.10.2",
    "puppeteer-core": "^25.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.4",
    "@nestjs/testing": "^11.1.3",
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.3",
    "@types/uuid": "^11.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3"
  }
}
