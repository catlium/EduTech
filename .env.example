# ──────────────────────────────────────────────
# CatLium EduTech - Root Environment Variables
# ──────────────────────────────────────────────

# General
NODE_ENV=development

# ──────────────────────────────────────────────
# API (NestJS)
# ──────────────────────────────────────────────
API_PORT=3000
CORS_ORIGIN=http://localhost:3001

# JWT
# Generate a strong secret in production: openssl rand -hex 64
# The API refuses to start with NODE_ENV=production unless JWT_SECRET is set.
JWT_SECRET=change-me-to-a-secure-random-string
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30

# Cookies
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Rate Limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_LIMIT=5

# Database (PostgreSQL)
DATABASE_URL=postgresql://catlium:catlium_dev_secret@localhost:5432/catlium_dev

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://catlium:catlium_dev_secret@localhost:5672

# File storage (local for MVP; replaceable via the storage provider abstraction)
STORAGE_LOCAL_DIR=./storage

# ──────────────────────────────────────────────
# Internal services
# ──────────────────────────────────────────────
# Shared secret for the internal-auth convention (`x-internal-api-key`):
# workers send it to the OCR service on /extract. Empty in local dev;
# MUST be set to a strong random value in production.
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=

# ──────────────────────────────────────────────
# OCR Service (FastAPI)
# ──────────────────────────────────────────────
OCR_HOST=0.0.0.0
OCR_PORT=8000
OCR_RELOAD=true
# Mirrors INTERNAL_API_KEY (compose sets OCR_INTERNAL_API_KEY itself).
OCR_INTERNAL_API_KEY=

# ──────────────────────────────────────────────
# OmniRoute AI gateway (internal, OpenAI-compatible /v1)
# ──────────────────────────────────────────────
# First-run settings for the internal gateway. Create ONE provider connection
# + endpoint key in the OmniRoute dashboard, then put that key in
# WORKER_AI_API_KEY. Secrets are NEVER hardcoded.
OMNIROUTE_INITIAL_PASSWORD=change-me-to-a-strong-password
OMNIROUTE_JWT_SECRET=change-me-to-a-long-random-secret

# ──────────────────────────────────────────────
# Workers (Python)
# ──────────────────────────────────────────────
WORKER_RABBITMQ_URL=amqp://catlium:catlium_dev_secret@localhost:5672
WORKER_DATABASE_URL=postgresql://catlium:catlium_dev_secret@localhost:5432/catlium_dev
WORKER_OCR_URL=http://localhost:8000
WORKER_INTERNAL_API_KEY=
WORKER_STORAGE_DIR=./storage
# WORKER_ROLE=material | ai — selects which consumer the worker process runs
WORKER_ROLE=material

# AI generation worker. AI goes ONLY through the internal OmniRoute gateway
# (OpenAI-compatible /v1). No local LLM ever. In the compose stack the default
# is http://omniroute:20128/v1; the value here is for host-based dev (dev
# override publishes the gateway on 127.0.0.1:20128). May be overridden to any
# OpenAI-compatible endpoint with a matching WORKER_AI_API_KEY.
WORKER_AI_PROVIDER_URL=http://localhost:20128/v1
# OmniRoute endpoint key (created in the OmniRoute dashboard -> Endpoints).
WORKER_AI_API_KEY=
WORKER_AI_MODEL=auto
WORKER_AI_TIMEOUT_SECONDS=60
WORKER_AI_QUEUE=ai_generation
WORKER_AI_MAX_CONTEXT_CHARS=40000
# Chunking (characters, provider-agnostic): large documents are split on
# semantic boundaries before any AI call.
WORKER_AI_CHUNK_SIZE_CHARS=12000
WORKER_AI_CHUNK_OVERLAP_CHARS=400
