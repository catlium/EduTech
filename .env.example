# ──────────────────────────────────────────────
# CatLium EduTech - Root Environment Variables
# ──────────────────────────────────────────────

# General
NODE_ENV=development

# ──────────────────────────────────────────────
# API (NestJS)
# ──────────────────────────────────────────────
API_PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://catlium:catlium_dev_secret@localhost:5432/catlium_dev

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://catlium:catlium_dev_secret@localhost:5672

# ──────────────────────────────────────────────
# OCR Service (FastAPI)
# ──────────────────────────────────────────────
OCR_HOST=0.0.0.0
OCR_PORT=8000
OCR_RELOAD=true

# ──────────────────────────────────────────────
# Workers (Python)
# ──────────────────────────────────────────────
WORKER_CELERY_BROKER_URL=amqp://catlium:catlium_dev_secret@localhost:5672
WORKER_CELERY_RESULT_BACKEND=redis://localhost:6379/0
