# ──────────────────────────────────────────────
# CatLium EduTech - Root Environment Variables
# ──────────────────────────────────────────────

# General
NODE_ENV=development

# ──────────────────────────────────────────────
# API (NestJS)
# ──────────────────────────────────────────────
API_PORT=3000
CORS_ORIGIN=http://localhost:3001

# JWT
# Generate a strong secret in production: openssl rand -hex 64
# The API refuses to start with NODE_ENV=production unless JWT_SECRET is set.
JWT_SECRET=change-me-to-a-secure-random-string
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30

# Cookies
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Rate Limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_LIMIT=5

# Database (PostgreSQL)
DATABASE_URL=postgresql://catlium:catlium_dev_secret@localhost:5432/catlium_dev

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://catlium:catlium_dev_secret@localhost:5672

# File storage (local for MVP; replaceable via the storage provider abstraction)
STORAGE_LOCAL_DIR=./storage

# ──────────────────────────────────────────────
# Web (Next.js)
# ──────────────────────────────────────────────
# Build-time API base the browser talks to. In Docker this is passed as a
# build ARG (docker-compose.yml -> web build) — changing it requires a rebuild.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Port for host `next dev`/`next start` and the dockerized web service.
WEB_PORT=3001

# ──────────────────────────────────────────────
# Internal services
# ──────────────────────────────────────────────
# Shared secret for the internal-auth convention (`x-internal-api-key`):
# workers send it to the OCR service on /extract. Empty in local dev;
# MUST be set to a strong random value in production.
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=

# ──────────────────────────────────────────────
# OCR Service (FastAPI)
# ──────────────────────────────────────────────
OCR_HOST=0.0.0.0
OCR_PORT=8000
OCR_RELOAD=true
# Mirrors INTERNAL_API_KEY (compose sets OCR_INTERNAL_API_KEY itself).
OCR_INTERNAL_API_KEY=
# Extraction chunking + resource limits (defaults apply if omitted). The OCR
# service chunks long PDFs internally; /extract stays ONE request/response.
OCR_CHUNK_PAGES=10
OCR_MAX_PAGES=0
OCR_MAX_FILE_BYTES=0
OCR_RETRY_COUNT=2
OCR_RETRY_BACKOFF_SECONDS=1.0

# ──────────────────────────────────────────────
# OmniRoute AI gateway (internal, OpenAI-compatible /v1)
# ──────────────────────────────────────────────
# First-run settings for the internal gateway. Create ONE provider connection
# + endpoint key in the OmniRoute dashboard, then put that key in
# WORKER_AI_API_KEY. Secrets are NEVER hardcoded.
OMNIROUTE_INITIAL_PASSWORD=change-me-to-a-strong-password
OMNIROUTE_JWT_SECRET=change-me-to-a-long-random-secret

# ──────────────────────────────────────────────
# Workers (Python)
# ──────────────────────────────────────────────
WORKER_RABBITMQ_URL=amqp://catlium:catlium_dev_secret@localhost:5672
WORKER_DATABASE_URL=postgresql://catlium:catlium_dev_secret@localhost:5432/catlium_dev
WORKER_OCR_URL=http://localhost:8000
WORKER_INTERNAL_API_KEY=
WORKER_STORAGE_DIR=./storage
# WORKER_ROLE=material | ai — selects which consumer the worker process runs
WORKER_ROLE=material
# Worker-side HTTP bounds to the OCR service / distributed OCR worker↔API
# calls. One /extract (legacy) or a chunk source-download+submit may take
# minutes for large handwritten documents — the read timeout must allow that.
WORKER_OCR_CONNECT_TIMEOUT_SECONDS=10
WORKER_OCR_READ_TIMEOUT_SECONDS=300
# Worker-material stale-processing recovery: exactly the outage root cause on
# this queue — a crashed worker left syllabus jobs stuck in `processing`
# forever. On startup, jobs older than this are reset to `queued` and
# re-published. (MATERIAL_PROCESS is coordinator-owned; never swept here.)
WORKER_MATERIAL_STALE_PROCESSING_MINUTES=60

# ──────────────────────────────────────────────
# Distributed OCR worker (external pull worker)
# ──────────────────────────────────────────────
# Standalone image (infrastructure/compose/Dockerfile.ocr-worker). Runs OCR
# computation ONLY — never touches Postgres/RabbitMQ/OmniRoute/NestJS source.
# It polls the NestJS Worker API over HTTPS. CONNECT/READ timeouts above apply
# to the worker↔API calls too (source download rides the read timeout).
#
# Bootstrap: register a worker once (admin OCR UI or `POST /ocr/workers`). The
# response returns { workerId, apiKey } exactly once — put them here and start
# the worker image (compose dev also reads these for its `ocr-worker` service).
WORKER_OCR_SERVER_URL=http://localhost:3000/api/v1
WORKER_OCR_WORKER_ID=
WORKER_OCR_API_KEY=
# Poll/heartbeat cadence + claim blip backoff. Heartbeats renew the held
# chunk's lease, so a long OCR never loses ownership.
WORKER_OCR_IDLE_POLL_SECONDS=2
WORKER_OCR_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_OCR_CLAIM_RETRY_BACKOFF_SECONDS=2
# ── Server-side coordinator knobs (read by the NestJS API, not the worker) ──
WORKER_OCR_CHUNK_SIZE=10
WORKER_OCR_LEASE_SECONDS=300
WORKER_SWEEP_INTERVAL_MS=15000
WORKER_OFFLINE_SECONDS=120

# AI generation worker. AI goes ONLY through the internal OmniRoute gateway
# (OpenAI-compatible /v1). No local LLM ever. In the compose stack the default
# is http://omniroute:20128/v1; the value here is for host-based dev (dev
# override publishes the gateway on 127.0.0.1:20128). May be overridden to any
# OpenAI-compatible endpoint with a matching WORKER_AI_API_KEY.
WORKER_AI_PROVIDER_URL=http://localhost:20128/v1
# OmniRoute endpoint key (created in the OmniRoute dashboard -> Endpoints).
WORKER_AI_API_KEY=
WORKER_AI_MODEL=auto
WORKER_AI_READ_TIMEOUT_SECONDS=300
WORKER_AI_CONNECT_TIMEOUT_SECONDS=10
WORKER_AI_MAX_RETRIES=3
WORKER_AI_RETRY_BACKOFF_SECONDS=2
WORKER_AI_RETRY_BACKOFF_MAX_SECONDS=60
WORKER_AI_STALE_PROCESSING_MINUTES=60
WORKER_AI_QUEUE=ai_generation
# Independent AI jobs run in parallel up to this many worker threads (each
# its own RabbitMQ connection, prefetch 1).
WORKER_AI_CONCURRENCY=5
WORKER_AI_MAX_CONTEXT_CHARS=40000
# Chunking (characters, provider-agnostic): large documents are split on
# semantic boundaries before any AI call.
WORKER_AI_CHUNK_SIZE_CHARS=12000
WORKER_AI_CHUNK_OVERLAP_CHARS=400

# ──────────────────────────────────────────────
# Demo (deterministic mock AI)
# ──────────────────────────────────────────────
# The demo profile (docker-compose.demo.yml) and the E2E suites point the AI
# worker at a canned-response OpenAI-compatible server (mock_ai_provider.py)
# so the full happy path is reproducible with no live model. The response is
# chosen by the `model` string the worker sends: 'syllabus' -> SYLLABUS,
# 'note' -> NOTE, 'question' -> QUESTIONS. E2E suites set WORKER_AI_MODEL per
# stage; a dockerized worker uses WORKER_AI_MODEL for every operation, so with
# the default below the mock falls back to SYLLABUS (syllabus generation only).
MOCK_AI_HOST=127.0.0.1
MOCK_AI_PORT=8899

# ──────────────────────────────────────────────
# Cloudflare Tunnel (PRODUCTION public ingress)
# ──────────────────────────────────────────────
# Optional production-only override (docker-compose.tunnel.yml). Makes a
# Cloudflare Tunnel the ONLY public entry point — api/web stop publishing host
# ports, and internal services stay on the private network (they already have
# no host ports in production). Procedure: docs/architecture/cloudflare-tunnel.md
#
# TUNNEL_TOKEN: issued once in Cloudflare Zero Trust → Networks → Tunnels
# ("Create a tunnel" → copy the token). It embeds the tunnel credentials, so
# no credential file is committed. Leave empty/unset to disable the tunnel.
TUNNEL_TOKEN=

# For a tunneled deployment the browser must talk to the SAME public origin as
# the web app so cookies (access_token/refresh_token/csrf_token) and CSRF stay
# same-origin. Set this at BUILD time (it is baked into the web bundle):
#   NEXT_PUBLIC_API_URL=https://app.example.com/api/v1
# and serve the API through the tunnel route app.example.com/api/* → api:3000
# (the base default http://localhost:3000/api/v1 is dev/local only).

# Cookie posture over the public HTTPS origin (production):
#   COOKIE_SECURE=true        # HTTPS tunnel — Secure cookies
#   COOKIE_SAMESITE=lax       # same-origin fetch → lax is sufficient
#   COOKIE_DOMAIN=            # empty = host-only to the tunnel hostname
